# Copie para .env local; nunca publique credenciais. O Spring importa este arquivo com o comando do README.
# Supabase > Connect > Session pooler > JDBC. Use porta 5432.
SUPABASE_DB_URL=jdbc:postgresql://HOST_DO_SESSION_POOLER:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.REFERENCIA_DO_PROJETO
SUPABASE_DB_PASSWORD=PREENCHA_LOCALMENTE
# Cria um profissional somente se o e-mail ainda não estiver cadastrado.
AMBMAO_PROFISSIONAL_NOME=
AMBMAO_PROFISSIONAL_EMAIL=
AMBMAO_PROFISSIONAL_SENHA=
# true em produção HTTPS; false para testar por http://localhost
SESSION_COOKIE_SECURE=false
